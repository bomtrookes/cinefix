<div class="container">
  <div class="user-info my-4">
    <% if @user.avatar.attached? %>
      <%= image_tag @user.avatar, id: "user-avatar" %>
    <% else %>
      <img id="user-avatar" src="<%= @default %>" alt="">
    <% end %>

  <div class="d-flex flex-column">
    <h1><%= link_to @user.username, user_path(@user), style: "text-decoration:none;color:white" %></h1>
    <% if user_signed_in? && @user != current_user %>

      <% if current_user.followings.include?(@user) %>
        <%= button_to "Unfollow", user_follow_path(@user), class: "btn btn-danger", method: :delete %>
      <% else %>
        <%= button_to "Follow", user_follows_path(@user), class: "btn btn-success", method: :post %>
      <% end %>

    <% end %>
  </div>

</div>

  <% movie = tmdb_movie(@rating.api_id) %>
  <div class="rating-card">
    <div class="rating-card-head">
      <% if movie.poster_path.present? %>
        <%= link_to movie_path(@rating.api_id) do %>
          <%= image_tag "https://www.themoviedb.org/t/p/w185#{movie.poster_path}", class: "rating-card-poster", alt: "" %>
        <% end %>
      <% end %>
      <div class="rating-card-title">
        <h2><%= link_to movie.title, movie_path(@rating.api_id) %></h2>
        <small><%= format_date(movie.release_date) %></small>
        <% if @rating.documentary? %>
          <span class="rating-chip">Scored as a documentary</span>
        <% end %>
      </div>
      <div class="rating-card-score">
        <strong><%= @rating.total_score %></strong>
        <small>/ 10</small>
      </div>
    </div>

    <% if @rating.review.present? %>
      <% if @rating.spoilers? %>
        <details class="rating-review is-spoiler">
          <summary>Review contains spoilers. Tap to read.</summary>
          <%= simple_format(h(@rating.review)) %>
        </details>
      <% else %>
        <div class="rating-review"><%= simple_format(h(@rating.review)) %></div>
      <% end %>
    <% end %>

    <ul class="rating-bars">
      <% @rating.categories.each do |field, (label, _hint)| %>
        <% score = @rating.public_send(field) %>
        <li class="<%= 'is-na' if score.nil? %>">
          <span class="rating-bar-label"><%= label %></span>
          <span class="rating-bar-track"><span class="rating-bar-fill" style="width: <%= (score || 0) * 10 %>%"></span></span>
          <span class="rating-bar-val"><%= score.nil? ? "N/A" : score %></span>
        </li>
      <% end %>
    </ul>

    <% if user_signed_in? && @user == current_user %>
      <%= link_to "Edit your rating", edit_rating_path(@rating.api_id), class: "rating-edit" %>
    <% end %>
  </div>
</div>
