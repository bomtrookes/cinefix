<div class="list-page">
  <header class="list-head">
    <h1>Feed</h1>
    <p>Latest ratings from people you follow</p>
  </header>

  <% if @activities.empty? %>
    <div class="list-empty">
      <i class="bi bi-people"></i>
      <p>Nothing here yet. Follow a few people and their ratings will show up here.</p>
      <%= link_to "Find people", movies_path, class: "list-empty-btn" %>
    </div>
  <% else %>
    <% @activities.group_by { |activity| activity[:rating].created_at.to_date }.each do |day, activities| %>
      <h2 class="feed-day">
        <% if day == Date.current %>Today<% elsif day == Date.yesterday %>Yesterday<% else %><%= day.strftime("%-d %B %Y") %><% end %>
      </h2>
      <% activities.each do |activity| %>
        <% user = activity[:user] %>
        <% rating = activity[:rating] %>
        <% film = @films[rating.api_id] %>
        <%= link_to user_rating_path(user.id, rating.id), class: "feed-item" do %>
          <% if user.avatar.attached? %>
            <%= image_tag user.avatar, alt: "", class: "feed-face" %>
          <% else %>
            <span class="feed-face feed-initials"><%= user.username.first.upcase %></span>
          <% end %>

          <span class="feed-body">
            <span class="feed-line"><strong><%= user.username %></strong> rated</span>
            <span class="feed-film">
              <%= film&.title || "a film" %>
              <% if film&.year %><span class="feed-year"><%= film.year %></span><% end %>
            </span>
            <% if rating.review.present? %>
              <% if rating.spoilers? %>
                <span class="feed-review is-spoiler"><i class="bi bi-eye-slash"></i> Review hidden (contains spoilers)</span>
              <% else %>
                <span class="feed-review">“<%= truncate(rating.review, length: 140) %>”</span>
              <% end %>
            <% end %>
            <span class="feed-time"><%= time_ago_in_words(rating.created_at) %> ago</span>
          </span>

          <span class="feed-side">
            <% if film&.poster_url %>
              <img src="<%= film.poster_url %>" alt="" class="feed-poster" loading="lazy">
            <% else %>
              <span class="feed-poster"></span>
            <% end %>
            <span class="feed-score"><%= rating.total_score %></span>
          </span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
