<div class="search-page" data-controller="search">
  <%= form_with url: movies_path, method: :get, class: "search-box",
        data: { search_target: "form", turbo_frame: "search_results", turbo_action: "replace" } do %>
    <label for="query" class="visually-hidden">Search films, cast &amp; crew or users</label>
    <i class="bi bi-search" aria-hidden="true"></i>
    <%= search_field_tag :query, @query,
          placeholder: "Films, cast & crew or users",
          autocomplete: "off",
          data: { search_target: "input", action: "input->search#type" } %>
    <button type="button" class="search-clear" aria-label="Clear search"
            data-search-target="clear" data-action="search#clear" hidden>
      <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>
  <% end %>

  <%= turbo_frame_tag "search_results", class: "search-frame" do %>
    <% if @query.present? %>
      <%= render "search_results" %>
    <% else %>
      <%= render "search_start" %>
    <% end %>
  <% end %>
</div>
