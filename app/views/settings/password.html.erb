<%= render layout: "settings/frame", locals: { current: :password } do %>
  <h2 class="settings-heading">Password</h2>
  <%= form_with model: @user, url: password_settings_path, method: :patch, class: "settings-form" do |f| %>
    <div class="settings-field">
      <%= f.label :current_password %>
      <%= f.password_field :current_password, class: "settings-input", autocomplete: "current-password", required: true %>
      <%= settings_field_error(@user, :current_password) %>
    </div>
    <div class="settings-field">
      <%= f.label :password, "New password" %>
      <%= f.password_field :password, class: "settings-input", autocomplete: "new-password", required: true %>
      <%= settings_field_error(@user, :password) || tag.small("#{Devise.password_length.min} characters minimum", class: "settings-hint") %>
    </div>
    <div class="settings-field">
      <%= f.label :password_confirmation, "Confirm new password" %>
      <%= f.password_field :password_confirmation, class: "settings-input", autocomplete: "new-password", required: true %>
      <%= settings_field_error(@user, :password_confirmation) %>
    </div>
    <%= f.submit "Change password", class: "settings-btn" %>
  <% end %>

  <% if password_reset_available? %>
    <div class="settings-forgot">
      <span>Forgotten your current password?</span>
      <%= button_to "Email me a reset link", reset_link_settings_path, method: :post, class: "settings-link" %>
    </div>
  <% end %>
<% end %>
