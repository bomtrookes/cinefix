<%# First login for a friend added by an admin: one page, password required,
    photo and username optional. %>
<div class="auth-page">
  <div class="auth-card auth-card-wide">
    <h1 class="settings-title">Welcome to Reel<span class="auth-gold">Score</span></h1>
    <p class="auth-lead">Choose your own password to finish setting up. You can add a photo now or later.</p>

    <%= form_with model: @user, url: welcome_path, method: :patch, class: "settings-form",
                  data: { controller: "avatar-preview" } do |f| %>
      <div class="settings-field">
        <%= f.label :current_password, "Temporary password" %>
        <%= f.password_field :current_password, class: "settings-input", autocomplete: "current-password", required: true, autofocus: true %>
        <%= settings_field_error(@user, :current_password) || tag.small("The password you were sent", class: "settings-hint") %>
      </div>
      <div class="settings-field">
        <%= f.label :password, "New password" %>
        <%= f.password_field :password, class: "settings-input", autocomplete: "new-password", required: true %>
        <%= settings_field_error(@user, :password) || tag.small("#{Devise.password_length.min} characters minimum", class: "settings-hint") %>
      </div>
      <div class="settings-field">
        <%= f.label :password_confirmation, "Confirm new password" %>
        <%= f.password_field :password_confirmation, class: "settings-input", autocomplete: "new-password", required: true %>
        <%= settings_field_error(@user, :password_confirmation) %>
      </div>

      <div class="settings-divider"><span>Your profile</span></div>

      <div class="settings-photo">
        <%= settings_avatar(@user, big: true) %>
        <div class="settings-photo-pick">
          <%= f.label :avatar, "Choose photo", class: "settings-btn settings-btn-ghost" %>
          <%= f.file_field :avatar, accept: "image/*", class: "visually-hidden",
                           data: { avatar_preview_target: "input", action: "avatar-preview#pick" } %>
          <small data-avatar-preview-target="name">Optional</small>
        </div>
      </div>
      <div class="settings-field">
        <%= f.label :username %>
        <%= f.text_field :username, class: "settings-input", autocomplete: "username", required: true %>
        <%= settings_field_error(@user, :username) || tag.small("Change it if you like", class: "settings-hint") %>
      </div>

      <%= f.submit "Save and start rating", class: "settings-btn settings-btn-full" %>
    <% end %>
    <%= link_to "Log out", destroy_user_session_path, class: "auth-quiet", data: { turbo_method: :delete } %>
  </div>
</div>
