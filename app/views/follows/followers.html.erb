<div class="container my-3">
  <% mine = @user == current_user %>
  <h1><%= mine ? "Your followers" : "#{@user.username}'s followers" %></h1>

  <% if @followers.empty? %>
    <p class="py-3"><%= mine ? "No one follows you yet." : "#{@user.username} has no followers yet." %></p>
  <% else %>
    <% @followers.each do |follow| %>
      <%= link_to user_path(follow), class: "x-a" do %>
        <div class="follow-card">

        <% if follow.avatar.attached? %>
          <%= image_tag follow.avatar %>
        <% else %>
          <img src="<%= @default %>" alt="">
        <% end %>

          <p><%= follow.username %></p>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
