<div class="container my-3">

  <% mine = @user == current_user %>
  <h1><%= mine ? "People you follow" : "People #{@user.username} follows" %></h1>

  <% if @followings.empty? %>
    <p class="py-3"><%= mine ? "You're not following anyone yet. Find people in Search." : "#{@user.username} isn't following anyone yet." %></p>
  <% else %>
    <% @followings.each do |follow| %>
      <%= link_to user_path(follow), class: "x-a" do %>
        <div class="follow-card">

        <% if follow.avatar.attached? %>
          <%= image_tag follow.avatar %>
        <% else %>
          <img src="<%= @default %>" alt="">
        <% end %>

          <p><%= follow.username %></p>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
