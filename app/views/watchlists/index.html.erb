<div class="list-page">
  <header class="list-head">
    <h1><%= @user == current_user ? "Watchlist" : "#{@user.username}’s watchlist" %></h1>
    <p><%= pluralize(@watchlists.size, "film") %> to watch</p>
  </header>

  <% if @watchlists.empty? %>
    <div class="list-empty">
      <i class="bi bi-bookmark"></i>
      <p>No films on this watchlist yet.</p>
      <% if @user == current_user %>
        <%= link_to "Find a film", movies_path, class: "list-empty-btn" %>
      <% end %>
    </div>
  <% else %>
    <div class="watched-grid">
      <% @watchlists.each do |item| %>
        <% film = @films[item.api_id] %>
        <%= link_to movie_path(item.api_id), class: "watched-card" do %>
          <span class="watched-poster">
            <% if film&.poster_url %>
              <img src="<%= film.poster_url %>" alt="" loading="lazy">
            <% else %>
              <span class="watched-poster-blank"><%= film&.title || "Unknown film" %></span>
            <% end %>
          </span>
          <span class="watched-title"><%= film&.title || "Unknown film" %></span>
          <small class="watched-date">Added <%= item.created_at.strftime(item.created_at.year == Date.current.year ? "%-d %b" : "%-d %b %Y") %></small>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
