<div class="container mt-3">
  <% if @user == current_user %>
    <h1>Your Watchlist</h1>
  <% else %>
    <h1>Watchlist | <%= @user.username %></h1>
  <% end %>
    <% if @watchlists.present? %>
      <div class="watchlist mb-3">
        <% @watchlists.each do |movie| %>
          <%= link_to movie_path(movie.api_id) do %>
            <img src="<%= @films[movie.api_id]&.poster_url %>" alt="<%= @films[movie.api_id]&.title %>">
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="py-3">No movies here yet.</p>
    <% end %>
</div>
