<div class="auth-page">
  <div class="auth-card">
    <h1 class="settings-title">Account created</h1>
    <p class="auth-lead"><strong><%= @user.username %></strong> (<%= @user.email %>) can now log in with this temporary password:</p>

    <div class="auth-temp" data-controller="clipboard">
      <code data-clipboard-target="source"><%= @temp_password %></code>
      <button type="button" class="settings-btn settings-btn-ghost" data-action="clipboard#copy" data-clipboard-target="button">Copy</button>
    </div>

    <p class="auth-note">Send it to them privately. It won't be shown again. They'll choose their own password when they first log in.</p>
    <%= link_to "Add another friend", new_admin_user_path, class: "settings-btn settings-btn-ghost" %>
  </div>
</div>
