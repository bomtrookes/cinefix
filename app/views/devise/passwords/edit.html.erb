<div class="auth-page">
  <div class="auth-card">
    <h1 class="settings-title">Choose a new password</h1>

    <% if resource.errors[:reset_password_token].any? %>
      <div class="auth-alert">
        This reset link has expired or was already used.
        <%= link_to "Send a new one", new_password_path(resource_name), class: "settings-link" %>
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "settings-form" }) do |f| %>
      <%= f.hidden_field :reset_password_token %>
      <div class="settings-field">
        <%= f.label :password, "New password" %>
        <%= f.password_field :password, class: "settings-input", autofocus: true, autocomplete: "new-password", required: true %>
        <%= settings_field_error(resource, :password) ||
              (tag.small("#{@minimum_password_length} characters minimum", class: "settings-hint") if @minimum_password_length) %>
      </div>
      <div class="settings-field">
        <%= f.label :password_confirmation, "Confirm new password" %>
        <%= f.password_field :password_confirmation, class: "settings-input", autocomplete: "new-password", required: true %>
        <%= settings_field_error(resource, :password_confirmation) %>
      </div>
      <%= f.submit "Save and log in", class: "settings-btn settings-btn-full" %>
    <% end %>
  </div>
</div>
