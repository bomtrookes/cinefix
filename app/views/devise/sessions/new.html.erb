<div class="auth-page">
  <div class="auth-card">
    <h1 class="settings-title">Log in</h1>

    <div class="auth-demo">
      Try the demo: <strong>demo@tombrookes.dev</strong> / <strong>reelscore-demo</strong>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "settings-form" }) do |f| %>
      <div class="settings-field">
        <%= f.label :email %>
        <%= f.email_field :email, class: "settings-input", autofocus: true, autocomplete: "email" %>
      </div>
      <div class="settings-field">
        <div class="settings-label-row">
          <%= f.label :password %>
          <% if password_reset_available? %>
            <%= link_to "Forgot password?", new_password_path(resource_name), class: "settings-link" %>
          <% end %>
        </div>
        <%= f.password_field :password, class: "settings-input", autocomplete: "current-password" %>
      </div>
      <% if devise_mapping.rememberable? %>
        <label class="auth-check">
          <%= f.check_box :remember_me %> Remember me
        </label>
      <% end %>
      <%= f.submit "Log in", class: "settings-btn settings-btn-full" %>
    <% end %>
  </div>
</div>
