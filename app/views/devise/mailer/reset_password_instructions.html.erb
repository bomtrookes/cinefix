<div style="background:#161616;padding:32px 16px;font-family:Helvetica,Arial,sans-serif;">
  <div style="max-width:480px;margin:0 auto;background:#222222;border:1px solid #3a3a3a;border-radius:14px;padding:28px 24px;color:#ffffff;">
    <p style="margin:0 0 20px;font-family:'Patua One',Georgia,serif;font-size:24px;">Reel<span style="color:#f2b632;">Score</span></p>
    <p style="margin:0 0 14px;font-size:15px;line-height:1.55;">Hi <%= @resource.username.presence || @resource.email %>,</p>
    <p style="margin:0 0 22px;font-size:15px;line-height:1.55;">Someone asked to reset the password for your ReelScore account. Tap below to choose a new one.</p>
    <p style="margin:0 0 22px;">
      <%= link_to "Choose a new password", edit_password_url(@resource, reset_password_token: @token),
                  style: "display:inline-block;background:#f2b632;color:#161616;font-weight:bold;text-decoration:none;padding:12px 22px;border-radius:999px;font-size:15px;" %>
    </p>
    <p style="margin:0;font-size:13px;line-height:1.5;color:#a7a7a7;">This link works once and expires in <%= Devise.reset_password_within.inspect %>. If you didn't ask for this, ignore this email and your password won't change.</p>
  </div>
</div>
